# Copy to .env for local runs. Never commit .env. Sandbox only: never point this at prod.
ENV=local
LOG_LEVEL=INFO

# Postgres (sandbox: through cloud-sql-proxy on 127.0.0.1:55433)
POSTGRES__HOST=127.0.0.1
POSTGRES__PORT=55433
POSTGRES__DB=clevrr_db
POSTGRES__USER=postgres
POSTGRES__PASSWORD=
# The ETL writes only this schema. Parity runs against legacy: etl_v2.
POSTGRES__TARGET_SCHEMA=etl_v2

# ClickHouse (sandbox: kubectl port-forward on 127.0.0.1:18124)
CLICKHOUSE__HOST=127.0.0.1
CLICKHOUSE__PORT=18124
CLICKHOUSE__USER=app
CLICKHOUSE__PASSWORD=
# The ETL writes only this database. Parity runs against legacy: clevrr_db_v2.
CLICKHOUSE__DATABASE=clevrr_db_v2
# CLICKHOUSE__CLUSTER=

# Only these orgs run (live provider calls are allowed for the pilot orgs only).
RUN__ORG_ALLOWLIST=["legendoftoys.com","shapercult.com","mydesignation.com"]

# ALERTS__SLACK_WEBHOOK_URL=
# API__BASE_URL=          # the backend's internal API (ADR-0003, later)
# API__AUDIENCE=
